---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TerminalWindow from '../components/TerminalWindow.astro';

const base = import.meta.env.BASE_URL;
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description: 'That page does not exist.',
		template: 'splash',
		tableOfContents: false,
		pagefind: false,
	}}
>
	<TerminalWindow index="0" title="Error" count="404">
		<pre>{`revision: no such page

  The path you asked for is not part of this documentation.
  It may have moved, or the link that brought you here may be stale.`}</pre>
	</TerminalWindow>

	<p>Try one of these instead:</p>

	<ul>
		<li><a href={base}>Home</a></li>
		<li><a href={`${base}guides/introduction/`}>Introduction</a></li>
		<li><a href={`${base}guides/installation/`}>Installation</a></li>
		<li><a href={`${base}reference/keybindings/`}>Keybindings</a></li>
		<li><a href={`${base}operations/troubleshooting/`}>Troubleshooting</a></li>
	</ul>

	<p>
		Or search with the box in the header. If a link on this site brought you here, please
		<a href="https://github.com/bapatchirag/revision/issues">report it</a>.
	</p>
</StarlightPage>
