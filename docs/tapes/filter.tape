# revision — filtering the Files and Log panels.
# Embedded on the Filtering & searching page.

Output site/public/demos/filter.mp4
Source docs/tapes/common.tape

Hide
Type "2"
Sleep 1500ms
Show

Sleep 1200ms

# In a list panel / hides non-matching rows, and the footer keeps the full
# unfiltered count in brackets.
Type "/"
Sleep 1s
Type "state:M"
Sleep 1800ms
Enter
Sleep 2800ms
Escape
Sleep 1800ms

# The Log panel takes parameters of its own.
Type "3"
Sleep 1200ms
Type "/"
Sleep 1s
Type "path:internal/server"
Sleep 1800ms
Enter
Sleep 2800ms
Escape
Sleep 1800ms
